@model IEnumerable<th_mm_pos.application.DTOs.ProductDto>

@{
    ViewData["Title"] = "Low Stock Alert";
}

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col">
            <h2><i class="bi bi-exclamation-triangle text-warning"></i> Low Stock Alert</h2>
            <p class="text-muted">Products below reorder level</p>
        </div>
        <div class="col-auto">
            <a asp-action="Index" class="btn btn-secondary">
                <i class="bi bi-arrow-left"></i> Back to Inventory
            </a>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-success">
            <i class="bi bi-check-circle"></i> All products are adequately stocked!
        </div>
    }
    else
    {
        <div class="card shadow-sm">
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead class="table-warning">
                            <tr>
                                <th>SKU</th>
                                <th>Name</th>
                                <th>Category</th>
                                <th>Current Quantity</th>
                                <th>Reorder Level</th>
                                <th>Shortage</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var product in Model)
                            {
                                <tr>
                                    <td><code>@product.SKU</code></td>
                                    <td>@product.Name</td>
                                    <td>@product.Category</td>
                                    <td><strong class="text-danger">@product.Quantity</strong></td>
                                    <td>@product.ReorderLevel</td>
                                    <td><span class="badge bg-danger">@(product.ReorderLevel - product.Quantity) units short</span></td>
                                    <td>
                                        <a asp-action="Edit" asp-route-id="@product.Id" class="btn btn-sm btn-primary">
                                            <i class="bi bi-plus-circle"></i> Restock
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>
