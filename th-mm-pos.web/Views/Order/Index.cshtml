@model IEnumerable<th_mm_pos.application.DTOs.OrderDto>

@{
    ViewData["Title"] = "Order Management";
}

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col">
            <h2><i class="bi bi-receipt"></i> Order Management</h2>
            <p class="text-muted">Manage customer orders and fulfillment</p>
        </div>
        <div class="col-auto">
            <a asp-action="Create" class="btn btn-primary">
                <i class="bi bi-plus-circle"></i> Create Order
            </a>
        </div>
    </div>

    <div class="card shadow-sm mb-3">
        <div class="card-body">
            <form method="get" class="row g-3">
                <div class="col-md-3">
                    <select name="status" class="form-select">
                        <option value="">All Statuses</option>
                        <option value="0">Pending</option>
                        <option value="1">Processing</option>
                        <option value="2">Ready</option>
                        <option value="3">Completed</option>
                        <option value="4">Cancelled</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <input type="text" name="customer" class="form-control" placeholder="Customer name">
                </div>
                <div class="col-auto">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-search"></i> Search
                    </button>
                </div>
            </form>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead class="table-light">
                        <tr>
                            <th>Order #</th>
                            <th>Customer</th>
                            <th>Phone</th>
                            <th>Order Date</th>
                            <th>Expected Date</th>
                            <th>Status</th>
                            <th>Items</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var order in Model)
                        {
                            <tr>
                                <td><strong>#@order.Id</strong></td>
                                <td>@order.CustomerName</td>
                                <td>@order.CustomerPhone</td>
                                <td>@order.OrderDate.ToString("yyyy-MM-dd HH:mm")</td>
                                <td>
                                    @if (order.ExpectedFulfillmentDate.HasValue)
                                    {
                                        @order.ExpectedFulfillmentDate.Value.ToString("yyyy-MM-dd")
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td>
                                    @switch (order.Status)
                                    {
                                        case th_mm_pos.domain.Enums.OrderStatus.Pending:
                                            <span class="badge bg-warning">Pending</span>
                                            break;
                                        case th_mm_pos.domain.Enums.OrderStatus.Processing:
                                            <span class="badge bg-info">Processing</span>
                                            break;
                                        case th_mm_pos.domain.Enums.OrderStatus.Ready:
                                            <span class="badge bg-primary">Ready</span>
                                            break;
                                        case th_mm_pos.domain.Enums.OrderStatus.Completed:
                                            <span class="badge bg-success">Completed</span>
                                            break;
                                        case th_mm_pos.domain.Enums.OrderStatus.Cancelled:
                                            <span class="badge bg-danger">Cancelled</span>
                                            break;
                                    }
                                </td>
                                <td>@order.Items.Count items</td>
                                <td>
                                    <a asp-action="Details" asp-route-id="@order.Id" class="btn btn-sm btn-outline-primary">
                                        <i class="bi bi-eye"></i> View
                                    </a>
                                    @if (order.Status != th_mm_pos.domain.Enums.OrderStatus.Completed && 
                                         order.Status != th_mm_pos.domain.Enums.OrderStatus.Cancelled)
                                    {
                                        <form asp-action="Cancel" asp-route-id="@order.Id" method="post" class="d-inline">
                                            <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Cancel this order?')">
                                                <i class="bi bi-x-circle"></i> Cancel
                                            </button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
