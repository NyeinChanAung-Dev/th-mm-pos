@model th_mm_pos.application.DTOs.OrderDto

@{
    ViewData["Title"] = "Order Details";
}

<div class="container">
    <div class="row mb-4">
        <div class="col">
            <h2><i class="bi bi-receipt"></i> Order #@Model.Id</h2>
        </div>
        <div class="col-auto">
            <a asp-action="Index" class="btn btn-secondary">
                <i class="bi bi-arrow-left"></i> Back to Orders
            </a>
        </div>
    </div>

    <div class="row">
        <div class="col-md-8">
            <div class="card shadow-sm mb-3">
                <div class="card-header bg-light">
                    <h5 class="mb-0">Order Information</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <p><strong>Customer:</strong> @Model.CustomerName</p>
                            <p><strong>Phone:</strong> @Model.CustomerPhone</p>
                            <p><strong>Order Date:</strong> @Model.OrderDate.ToString("yyyy-MM-dd HH:mm")</p>
                        </div>
                        <div class="col-md-6">
                            <p><strong>Expected Date:</strong> 
                                @if (Model.ExpectedFulfillmentDate.HasValue)
                                {
                                    @Model.ExpectedFulfillmentDate.Value.ToString("yyyy-MM-dd")
                                }
                                else
                                {
                                    <span class="text-muted">Not specified</span>
                                }
                            </p>
                            <p><strong>Created By:</strong> @Model.CreatedByUsername</p>
                            <p><strong>Status:</strong> 
                                @switch (Model.Status)
                                {
                                    case th_mm_pos.domain.Enums.OrderStatus.Pending:
                                        <span class="badge bg-warning">Pending</span>
                                        break;
                                    case th_mm_pos.domain.Enums.OrderStatus.Processing:
                                        <span class="badge bg-info">Processing</span>
                                        break;
                                    case th_mm_pos.domain.Enums.OrderStatus.Ready:
                                        <span class="badge bg-primary">Ready</span>
                                        break;
                                    case th_mm_pos.domain.Enums.OrderStatus.Completed:
                                        <span class="badge bg-success">Completed</span>
                                        break;
                                    case th_mm_pos.domain.Enums.OrderStatus.Cancelled:
                                        <span class="badge bg-danger">Cancelled</span>
                                        break;
                                }
                            </p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card shadow-sm">
                <div class="card-header bg-light">
                    <h5 class="mb-0">Order Items</h5>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table">
                            <thead>
                                <tr>
                                    <th>Product</th>
                                    <th>Quantity</th>
                                    <th>Unit Price</th>
                                    <th>Total</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.Items)
                                {
                                    <tr>
                                        <td>@item.ProductName</td>
                                        <td>@item.Quantity</td>
                                        <td>@item.UnitPrice.ToString("C")</td>
                                        <td>@((item.Quantity * item.UnitPrice).ToString("C"))</td>
                                        <td>
                                            @if (item.IsFulfilled)
                                            {
                                                <span class="badge bg-success">Fulfilled</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-warning">Pending</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot>
                                <tr>
                                    <td colspan="3" class="text-end"><strong>Total:</strong></td>
                                    <td colspan="2"><strong>@Model.Items.Sum(i => i.Quantity * i.UnitPrice).ToString("C")</strong></td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm">
                <div class="card-header bg-light">
                    <h5 class="mb-0">Actions</h5>
                </div>
                <div class="card-body">
                    @if (Model.Status != th_mm_pos.domain.Enums.OrderStatus.Completed && 
                         Model.Status != th_mm_pos.domain.Enums.OrderStatus.Cancelled)
                    {
                        <div class="d-grid gap-2">
                            @if (Model.Status == th_mm_pos.domain.Enums.OrderStatus.Pending)
                            {
                                <form asp-action="UpdateStatus" method="post">
                                    <input type="hidden" name="id" value="@Model.Id" />
                                    <input type="hidden" name="status" value="1" />
                                    <button type="submit" class="btn btn-info w-100">
                                        <i class="bi bi-arrow-right-circle"></i> Start Processing
                                    </button>
                                </form>
                            }
                            
                            @if (Model.Status == th_mm_pos.domain.Enums.OrderStatus.Processing)
                            {
                                <form asp-action="UpdateStatus" method="post">
                                    <input type="hidden" name="id" value="@Model.Id" />
                                    <input type="hidden" name="status" value="2" />
                                    <button type="submit" class="btn btn-primary w-100">
                                        <i class="bi bi-check-circle"></i> Mark as Ready
                                    </button>
                                </form>
                            }
                            
                            @if (Model.Status == th_mm_pos.domain.Enums.OrderStatus.Ready)
                            {
                                <form asp-action="Complete" asp-route-id="@Model.Id" method="post">
                                    <button type="submit" class="btn btn-success w-100">
                                        <i class="bi bi-cart-check"></i> Complete Order
                                    </button>
                                </form>
                            }
                            
                            <hr>
                            
                            <form asp-action="Cancel" asp-route-id="@Model.Id" method="post">
                                <button type="submit" class="btn btn-danger w-100" onclick="return confirm('Cancel this order?')">
                                    <i class="bi bi-x-circle"></i> Cancel Order
                                </button>
                            </form>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-info mb-0">
                            This order is @Model.Status.ToString().ToLower() and cannot be modified.
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
