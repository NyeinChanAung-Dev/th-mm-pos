@model th_mm_pos.application.DTOs.DashboardMetrics

@{
    ViewData["Title"] = "Dashboard";
}

<div class="container-fluid">
    <h1 class="mb-4">Dashboard</h1>

    <div class="row">
        <div class="col-md-3 mb-4">
            <div class="card bg-primary text-white">
                <div class="card-body">
                    <h5 class="card-title">Daily Sales</h5>
                    <h2 class="mb-0">@Model.DailySales.ToString("C")</h2>
                </div>
            </div>
        </div>

        <div class="col-md-3 mb-4">
            <div class="card bg-success text-white">
                <div class="card-body">
                    <h5 class="card-title">Total Revenue</h5>
                    <h2 class="mb-0">@Model.TotalRevenue.ToString("C")</h2>
                </div>
            </div>
        </div>

        <div class="col-md-3 mb-4">
            <div class="card bg-info text-white">
                <div class="card-body">
                    <h5 class="card-title">Transactions Today</h5>
                    <h2 class="mb-0">@Model.TotalTransactionsToday</h2>
                </div>
            </div>
        </div>

        <div class="col-md-3 mb-4">
            <div class="card bg-warning text-white">
                <div class="card-body">
                    <h5 class="card-title">Low Stock Items</h5>
                    <h2 class="mb-0">@Model.LowStockProductCount</h2>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-12 mb-4">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">Top Selling Products</h5>
                </div>
                <div class="card-body">
                    @if (Model.TopSellingProducts.Any())
                    {
                        <table class="table table-striped">
                            <thead>
                                <tr>
                                    <th>Product Name</th>
                                    <th>SKU</th>
                                    <th>Quantity Sold</th>
                                    <th>Revenue</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var product in Model.TopSellingProducts)
                                {
                                    <tr>
                                        <td>@product.ProductName</td>
                                        <td>@product.SKU</td>
                                        <td>@product.TotalQuantitySold</td>
                                        <td>@product.TotalRevenue.ToString("C")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <p class="text-muted">No sales data available</p>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-12">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">Quick Actions</h5>
                </div>
                <div class="card-body">
                    <a asp-controller="Sales" asp-action="Index" class="btn btn-primary me-2">New Sale</a>
                    <a asp-controller="Order" asp-action="Create" class="btn btn-success me-2">New Order</a>
                    <a asp-controller="Inventory" asp-action="Create" class="btn btn-info me-2">Add Product</a>
                    <a asp-controller="Dashboard" asp-action="SalesReport" class="btn btn-secondary">View Reports</a>
                </div>
            </div>
        </div>
    </div>
</div>
