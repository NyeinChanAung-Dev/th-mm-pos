@model th_mm_pos.application.DTOs.SalesReport

@{
    ViewData["Title"] = "Sales Report";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Sales Report</h1>
        <a asp-action="ExportReport" asp-route-startDate="@ViewBag.StartDate" asp-route-endDate="@ViewBag.EndDate" class="btn btn-success">
            <i class="bi bi-download"></i> Export CSV
        </a>
    </div>

    <!-- Date Filter -->
    <div class="card mb-4">
        <div class="card-body">
            <form asp-action="SalesReport" method="get" class="row g-3">
                <div class="col-md-4">
                    <label for="startDate" class="form-label">Start Date</label>
                    <input type="date" class="form-control" id="startDate" name="startDate" value="@ViewBag.StartDate?.ToString("yyyy-MM-dd")" />
                </div>
                <div class="col-md-4">
                    <label for="endDate" class="form-label">End Date</label>
                    <input type="date" class="form-control" id="endDate" name="endDate" value="@ViewBag.EndDate?.ToString("yyyy-MM-dd")" />
                </div>
                <div class="col-md-4 d-flex align-items-end">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-funnel"></i> Filter
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Summary Cards -->
    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card bg-primary text-white">
                <div class="card-body">
                    <h6 class="card-title">Total Revenue</h6>
                    <h3 class="mb-0">@Model.TotalRevenue.ToString("C")</h3>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-success text-white">
                <div class="card-body">
                    <h6 class="card-title">Total Transactions</h6>
                    <h3 class="mb-0">@Model.TotalTransactions</h3>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-info text-white">
                <div class="card-body">
                    <h6 class="card-title">Average Transaction</h6>
                    <h3 class="mb-0">@Model.AverageTransactionValue.ToString("C")</h3>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-warning text-white">
                <div class="card-body">
                    <h6 class="card-title">Total Tax</h6>
                    <h3 class="mb-0">@Model.TotalTax.ToString("C")</h3>
                </div>
            </div>
        </div>
    </div>

    <!-- Sales by Payment Method -->
    <div class="card mb-4">
        <div class="card-header">
            <h5 class="mb-0">Revenue by Payment Method</h5>
        </div>
        <div class="card-body">
            @if (Model.RevenueByPaymentMethod.Any())
            {
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>Payment Method</th>
                            <th>Total Amount</th>
                            <th>Percentage</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var payment in Model.RevenueByPaymentMethod)
                        {
                            var percentage = Model.TotalRevenue > 0 ? (payment.Value / Model.TotalRevenue * 100) : 0;
                            <tr>
                                <td>@payment.Key</td>
                                <td>@payment.Value.ToString("C")</td>
                                <td>@percentage.ToString("F1")%</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p class="text-muted">No payment data available</p>
            }
        </div>
    </div>

    <!-- Top Products -->
    <div class="card">
        <div class="card-header">
            <h5 class="mb-0">Top Selling Products</h5>
        </div>
        <div class="card-body">
            @if (Model.TopSellingProducts.Any())
            {
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>Rank</th>
                            <th>Product Name</th>
                            <th>SKU</th>
                            <th>Quantity Sold</th>
                            <th>Revenue</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            var rank = 1;
                        }
                        @foreach (var product in Model.TopSellingProducts)
                        {
                            <tr>
                                <td>@rank</td>
                                <td>@product.ProductName</td>
                                <td>@product.SKU</td>
                                <td>@product.TotalQuantitySold</td>
                                <td>@product.TotalRevenue.ToString("C")</td>
                            </tr>
                            rank++;
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p class="text-muted">No product sales data available</p>
            }
        </div>
    </div>
</div>
