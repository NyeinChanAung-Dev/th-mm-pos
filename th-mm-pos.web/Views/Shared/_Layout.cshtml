@using th_mm_pos.infrastructure.Constants

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"] - TH-MM POS System</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/>
    <link rel="stylesheet" href="~/css/design-system/tokens.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/css/design-system/colors.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/css/design-system/typography.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/css/design-system/spacing.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/css/themes/light.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/css/themes/dark.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
</head>
<body>
<header>
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary">
        <div class="container-fluid">
            <a class="navbar-brand" asp-controller="Dashboard" asp-action="Index">
                <i class="bi bi-shop"></i> TH-MM POS
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                @{
                    var claimUserNameFromSession = User.FindFirst(claim => claim.Type == Constants.ClaimUserName)?.Value;
                }
                @if (!string.IsNullOrEmpty(claimUserNameFromSession))
                {
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Dashboard" asp-action="Index">
                                <i class="bi bi-speedometer2"></i> Dashboard
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Sales" asp-action="Index">
                                <i class="bi bi-cart-check"></i> Sales
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Inventory" asp-action="Index">
                                <i class="bi bi-box-seam"></i> Inventory
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Order" asp-action="Index">
                                <i class="bi bi-receipt"></i> Orders
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Dashboard" asp-action="SalesReport">
                                <i class="bi bi-graph-up"></i> Reports
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Admin" asp-action="Index">
                                <i class="bi bi-people"></i> Admin
                            </a>
                        </li>
                    </ul>
                    <ul class="navbar-nav">
                        <li class="nav-item">
                            <button class="btn btn-link nav-link" 
                                    data-theme-toggle 
                                    aria-label="Toggle theme"
                                    title="Toggle light/dark mode">
                                <i class="bi bi-sun-fill theme-icon-light" style="display: none;"></i>
                                <i class="bi bi-moon-fill theme-icon-dark"></i>
                            </button>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" id="userDropdown" role="button"
                               data-bs-toggle="dropdown">
                                <i class="bi bi-person-circle"></i> @claimUserNameFromSession
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li>
                                    <form asp-controller="Auth" asp-action="Logout" method="post" class="px-3 py-2">
                                        <button type="submit" class="btn btn-sm btn-outline-danger w-100">
                                            <i class="bi bi-box-arrow-right"></i> Logout
                                        </button>
                                    </form>
                                </li>
                            </ul>
                        </li>
                    </ul>
                }
            </div>
        </div>
    </nav>
</header>

<main class="container-fluid py-4">
    @RenderBody()
</main>

<footer class="border-top footer text-muted mt-5">
    <div class="container text-center py-3">
        &copy; 2026 - TH-MM POS System
    </div>
</footer>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
<script src="~/js/theme-toggle.js" asp-append-version="true"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
